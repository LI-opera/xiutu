# Copy to .env and supply your own local configuration; never commit .env.
APP_MODE=development
DATA_PATH=.local-data
APP_ORIGIN=http://localhost:5215
LOCAL_DEV_AUTO_IDENTITY=true
# Replace password locally; only local PostgreSQL on port 5433 is supported.
DATABASE_URL=postgresql://xiutu:replace-with-local-password@127.0.0.1:5433/xiutu_dev
# TEST_DATABASE_URL must point to an explicitly isolated xiutu_test_* database.
# TEST_DATABASE_URL=
# Optional real AI; no model calls occur during setup or ordinary refresh.
# DEEPSEEK_API_KEY=
LLM_PROVIDER=deepseek
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
AREA_ANALYSIS_MAX_OUTPUT_TOKENS=8192
AREA_ANALYSIS_MAX_INPUT_CHARS=100000
# Local embedding model for manual chunks and retrieval; install it locally before indexing.
EMBEDDING_PROVIDER=local_bge_m3
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_REVISION=5617a9f61b028005a4858fdac845db406aefb181
EMBEDDING_DIMENSION=1024
EMBEDDING_LOCAL_FILES_ONLY=true
# EMBEDDING_MODEL_PATH=<local-BGE-model-snapshot>
# EMBEDDING_PATH=<local-E5-directory, only if EMBEDDING_PROVIDER=local_e5>
