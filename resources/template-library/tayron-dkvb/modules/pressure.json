      ],
      "outputs": {
        "consistent": "consistent",
        "single_outlier": {
          "PRS-02": "g31_outlier",
          "PRS-03": "g71_outlier"
        },
        "multiple_outliers": "multiple_outliers"
      },
      "reasons": {
        "consistent": "三项同批静态值落在本模板 30 hPa 比较带内；该带宽仅用于提示核查，不是厂家判废值。",
        "g31_outlier": "G31 静态值偏离环境参考超过本模板 30 hPa 比较带；先核对单位、工况与传感器数据来源。",
        "g71_outlier": "G71 静态值偏离环境参考超过本模板 30 hPa 比较带；先核对单位、工况与传感器数据来源。",
        "multiple_outliers": "静态值差异超过本模板比较带；不能直接据此判定某个部件失效。"
