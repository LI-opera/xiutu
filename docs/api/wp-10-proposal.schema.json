{
  "$defs": {
    "Action": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 12,
          "title": "References",
          "type": "array"
        },
        "operation": {
          "enum": [
            "inspect",
            "measure",
            "read",
            "actuate"
          ],
          "title": "Operation",
          "type": "string"
        }
      },
      "required": [
        "text",
        "operation"
      ],
      "title": "Action",
      "type": "object"
    },
    "AreaCandidate": {
      "additionalProperties": false,
      "properties": {
        "component_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Component Key",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/Claim"
        },
        "children": {
          "items": {
            "$ref": "#/$defs/AreaLeaf"
          },
          "maxItems": 8,
          "title": "Children",
          "type": "array"
        }
      },
      "required": [
        "component_key",
        "title",
        "rationale"
      ],
      "title": "AreaCandidate",
      "type": "object"
    },
    "AreaLeaf": {
      "additionalProperties": false,
      "properties": {
        "component_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Component Key",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "rationale": {
          "$ref": "#/$defs/Claim"
        }
      },
      "required": [
        "component_key",
        "title",
        "rationale"
      ],
      "title": "AreaLeaf",
      "type": "object"
    },
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "references": {
          "items": {
            "$ref": "#/$defs/Reference"
          },
          "maxItems": 12,
          "title": "References",
          "type": "array"
        }
      },
      "required": [
        "text"
      ],
      "title": "Claim",
      "type": "object"
    },
    "ConcludeArea": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "conclude_area",
          "title": "Type",
          "type": "string"
        },
        "component_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Component Key",
          "type": "string"
        },
        "finding": {
          "$ref": "#/$defs/Claim"
        },
        "support_rule_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Support Rule Id"
        },
        "conclusion_scope": {
          "anyOf": [
            {
              "enum": [
                "contact_fault",
                "housing_damage"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Conclusion Scope"
        },
        "assessment": {
          "enum": [
            "hypothesis",
            "temporarily_excluded",
            "unknown",
            "not_checked",
            "insufficient_data"
          ],
          "title": "Assessment",
          "type": "string"
        },
        "observation_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 20,
          "title": "Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "type",
        "component_key",
        "finding",
        "assessment"
      ],
      "title": "ConcludeArea",
      "type": "object"
    },
    "InputSpec": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "choice",
            "measurement",
            "composite"
          ],
          "title": "Kind",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 8,
          "title": "Choices",
          "type": "array"
        },
        "measurements": {
          "items": {
            "$ref": "#/$defs/SpecAssertion"
          },
          "maxItems": 8,
          "title": "Measurements",
          "type": "array"
        }
      },
      "required": [
        "kind"
      ],
      "title": "InputSpec",
      "type": "object"
    },
    "NeedInput": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "need_input",
          "title": "Type",
          "type": "string"
        },
        "missing": {
          "items": {
            "maxLength": 2000,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 20,
          "minItems": 1,
          "title": "Missing",
          "type": "array"
        }
      },
      "required": [
        "type",
        "missing"
      ],
      "title": "NeedInput",
      "type": "object"
    },
    "ProposeAreas": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "propose_areas",
          "title": "Type",
          "type": "string"
        },
        "areas": {
          "items": {
            "$ref": "#/$defs/AreaCandidate"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Areas",
          "type": "array"
        }
      },
      "required": [
        "type",
        "areas"
      ],
      "title": "ProposeAreas",
      "type": "object"
    },
    "ProposeStep": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "propose_step",
          "title": "Type",
          "type": "string"
        },
        "component_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Component Key",
          "type": "string"
        },
        "title": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/Claim"
        },
        "location": {
          "anyOf": [
            {
              "$ref": "#/$defs/Claim"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "prerequisites": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 12,
          "title": "Prerequisites",
          "type": "array"
        },
        "actions": {
          "items": {
            "$ref": "#/$defs/Action"
          },
          "maxItems": 12,
          "title": "Actions",
          "type": "array"
        },
        "input": {
          "$ref": "#/$defs/InputSpec"
        },
        "interpretation": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 12,
          "title": "Interpretation",
          "type": "array"
        },
        "retest": {
          "anyOf": [
            {
              "$ref": "#/$defs/Retest"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "type",
        "component_key",
        "title",
        "purpose",
        "input"
      ],
      "title": "ProposeStep",
      "type": "object"
    },
    "Reference": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "document_version_id": {
          "format": "uuid",
          "title": "Document Version Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "document_version_id"
      ],
      "title": "Reference",
      "type": "object"
    },
    "RequestTools": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "const": "request_tools",
          "title": "Type",
          "type": "string"
        },
        "calls": {
          "items": {
            "$ref": "#/$defs/ToolRequest"
          },
          "maxItems": 6,
          "minItems": 1,
          "title": "Calls",
          "type": "array"
        }
      },
      "required": [
        "type",
        "calls"
      ],
      "title": "RequestTools",
      "type": "object"
    },
    "Retest": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "$ref": "#/$defs/Claim"
        },
        "observation_ids": {
          "items": {
            "format": "uuid",
            "type": "string"
          },
          "maxItems": 10,
          "minItems": 1,
          "title": "Observation Ids",
          "type": "array"
        }
      },
      "required": [
        "reason",
        "observation_ids"
      ],
      "title": "Retest",
      "type": "object"
    },
    "SpecAssertion": {
      "additionalProperties": false,
      "properties": {
        "evidence_id": {
          "format": "uuid",
          "title": "Evidence Id",
          "type": "string"
        },
        "supersedes_id": {
          "anyOf": [
            {
              "format": "uuid",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Supersedes Id"
        },
        "component_key": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Component Key",
          "type": "string"
        },
        "quantity": {
          "enum": [
            "temperature",
            "pressure",
            "voltage",
            "resistance"
          ],
          "title": "Quantity",
          "type": "string"
        },
        "unit": {
          "enum": [
            "C",
            "F",
            "Pa",
            "kPa",
            "bar",
            "V",
            "mV",
            "ohm",
            "kohm"
          ],
          "title": "Unit",
          "type": "string"
        },
        "lower": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Lower"
        },
        "upper": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Upper"
        },
        "lower_inclusive": {
          "default": false,
          "title": "Lower Inclusive",
          "type": "boolean"
        },
        "upper_inclusive": {
          "default": false,
          "title": "Upper Inclusive",
          "type": "boolean"
        },
        "conditions": {
          "additionalProperties": {
            "type": "string"
          },
          "maxProperties": 20,
          "minProperties": 1,
          "title": "Conditions",
          "type": "object"
        },
        "spec_id": {
          "format": "uuid",
          "title": "Spec Id",
          "type": "string"
        }
      },
      "required": [
        "evidence_id",
        "component_key",
        "quantity",
        "unit",
        "conditions",
        "spec_id"
      ],
      "title": "SpecAssertion",
      "type": "object"
    },
    "ToolRequest": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "maxLength": 100,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "arguments": {
          "additionalProperties": true,
          "maxProperties": 20,
          "title": "Arguments",
          "type": "object"
        }
      },
      "required": [
        "name"
      ],
      "title": "ToolRequest",
      "type": "object"
    }
  },
  "discriminator": {
    "mapping": {
      "conclude_area": "#/$defs/ConcludeArea",
      "need_input": "#/$defs/NeedInput",
      "propose_areas": "#/$defs/ProposeAreas",
      "propose_step": "#/$defs/ProposeStep",
      "request_tools": "#/$defs/RequestTools"
    },
    "propertyName": "type"
  },
  "oneOf": [
    {
      "$ref": "#/$defs/RequestTools"
    },
    {
      "$ref": "#/$defs/ProposeAreas"
    },
    {
      "$ref": "#/$defs/ProposeStep"
    },
    {
      "$ref": "#/$defs/ConcludeArea"
    },
    {
      "$ref": "#/$defs/NeedInput"
    }
  ],
  "title": "ProposalEnvelope"
}
