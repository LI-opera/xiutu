    "compare_measurement": {
      "input": {
        "additionalProperties": false,
        "properties": {
          "spec_id": {
            "format": "uuid",
            "title": "Spec Id",
            "type": "string"
          },
          "value": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Value"
          },
          "unit": {
            "enum": [
              "C",
              "F",
              "Pa",
              "kPa",
              "bar",
              "V",
              "mV",
              "ohm",
              "kohm"
            ],
            "title": "Unit",
            "type": "string"
          },
          "conditions": {
            "additionalProperties": {
              "type": "string"
            },
            "maxProperties": 20,
            "title": "Conditions",
            "type": "object"
          }
        },
        "required": [
          "spec_id",
          "unit"
        ],
        "title": "MeasurementInput",
        "type": "object"
      },
      "output": {
        "additionalProperties": false,
        "properties": {
          "comparison_id": {
            "format": "uuid",
            "title": "Comparison Id",
            "type": "string"
          },
          "spec_id": {
            "format": "uuid",
            "title": "Spec Id",
            "type": "string"
          },
          "spec_version": {
            "title": "Spec Version",
            "type": "integer"
          },
          "outcome": {
            "title": "Outcome",
            "type": "string"
          },
          "input": {
            "additionalProperties": true,
            "title": "Input",
            "type": "object"
          },
          "converted": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Converted"
          },
          "converted_exact": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ],
            "title": "Converted Exact"
          },
          "synthetic": {
            "title": "Synthetic",
            "type": "boolean"
          },
          "diagnosis": {
            "const": false,
            "default": false,
            "title": "Diagnosis",
            "type": "boolean"
          }
        },
        "required": [
          "comparison_id",
          "spec_id",
          "spec_version",
          "outcome",
          "input",
          "converted",
          "converted_exact",
          "synthetic"
        ],
        "title": "CompareData",
        "type": "object"
      },
      "langchain": {
        "type": "function",
        "function": {
          "name": "compare_measurement",
          "description": "Compare a measurement using a currently approved case specification and required conditions. Persists one idempotent comparison; within_range is not diagnosis.",
          "parameters": {
            "additionalProperties": false,
            "properties": {
              "spec_id": {
                "format": "uuid",
                "title": "Spec Id",
                "type": "string"
              },
              "value": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Value"
              },
              "unit": {
                "enum": [
                  "C",
                  "F",
                  "Pa",
                  "kPa",
                  "bar",
                  "V",
                  "mV",
                  "ohm",
                  "kohm"
                ],
                "title": "Unit",
                "type": "string"
              },
              "conditions": {
                "additionalProperties": {
                  "type": "string"
                },
                "maxProperties": 20,
                "title": "Conditions",
                "type": "object"
