        "type": "function",
        "function": {
          "name": "get_case_observations",
          "description": "Read real immutable observations at an allowed case revision, optionally area filtered. Empty means no recorded observations; this tool never writes observations.",
          "parameters": {
            "additionalProperties": false,
            "properties": {
              "area_id": {
                "anyOf": [
