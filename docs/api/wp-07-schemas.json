{
  "schemas": {
    "search_manuals": {
      "input": {
        "$defs": {
          "VehicleScope": {
            "additionalProperties": false,
            "properties": {
              "model": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Model"
              },
              "year": {
                "anyOf": [
                  {
                    "maximum": 2100,
                    "minimum": 1886,
                    "type": "integer"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Year"
              },
              "engine_family": {
                "anyOf": [
                  {
                    "maxLength": 100,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Engine Family"
              },
              "engine_code": {
                "anyOf": [
                  {
                    "maxLength": 64,
                    "minLength": 1,
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ],
                "default": null,
                "title": "Engine Code"
              }
            },
            "title": "VehicleScope",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "query": {
            "maxLength": 2000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "vehicle_scope": {
            "$ref": "#/$defs/VehicleScope"
          },
          "top_k": {
            "default": 5,
            "maximum": 10,
            "minimum": 1,
            "title": "Top K",
            "type": "integer"
          }
        },
        "required": [
          "query"
        ],
        "title": "SearchInput",
        "type": "object"
      },
      "output": {
        "$defs": {
          "ChunkResult": {
            "additionalProperties": false,
            "properties": {
              "chunk_id": {
                "format": "uuid",
                "title": "Chunk Id",
                "type": "string"
              },
              "document_version_id": {
                "format": "uuid",
                "title": "Document Version Id",
                "type": "string"
              },
              "index_id": {
                "format": "uuid",
                "title": "Index Id",
                "type": "string"
              },
              "text": {
                "maxLength": 20000,
                "title": "Text",
                "type": "string"
              },
              "content_hash": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Content Hash",
                "type": "string"
              },
              "locator": {
                "additionalProperties": true,
                "title": "Locator",
                "type": "object"
              },
              "applicability": {
                "additionalProperties": true,
                "title": "Applicability",
                "type": "object"
              }
            },
            "required": [
              "chunk_id",
              "document_version_id",
              "index_id",
              "text",
              "content_hash",
              "locator",
              "applicability"
            ],
            "title": "ChunkResult",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "empty": {
            "title": "Empty",
            "type": "boolean"
          },
          "chunks": {
            "items": {
              "$ref": "#/$defs/ChunkResult"
            },
            "maxItems": 10,
            "title": "Chunks",
            "type": "array"
          }
        },
        "required": [
          "empty",
          "chunks"
        ],
        "title": "SearchData",
        "type": "object"
      },
      "langchain": {
        "type": "function",
        "function": {
          "name": "search_manuals",
          "description": "Search reviewed manuals in the trusted case frozen corpus. Scope only narrows. Empty means no eligible matches; never invent repair facts.",
          "parameters": {
            "$defs": {
              "VehicleScope": {
                "additionalProperties": false,
                "properties": {
                  "model": {
                    "anyOf": [
                      {
                        "maxLength": 100,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Model"
                  },
                  "year": {
                    "anyOf": [
                      {
                        "maximum": 2100,
                        "minimum": 1886,
                        "type": "integer"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Year"
                  },
                  "engine_family": {
                    "anyOf": [
                      {
                        "maxLength": 100,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Engine Family"
                  },
                  "engine_code": {
                    "anyOf": [
                      {
                        "maxLength": 64,
                        "minLength": 1,
                        "type": "string"
                      },
                      {
                        "type": "null"
                      }
                    ],
                    "default": null,
                    "title": "Engine Code"
                  }
                },
                "title": "VehicleScope",
                "type": "object"
              }
            },
            "additionalProperties": false,
            "properties": {
              "query": {
                "maxLength": 2000,
                "minLength": 1,
                "title": "Query",
                "type": "string"
              },
              "vehicle_scope": {
                "$ref": "#/$defs/VehicleScope"
              },
              "top_k": {
                "default": 5,
                "maximum": 10,
                "minimum": 1,
                "title": "Top K",
                "type": "integer"
              }
            },
            "required": [
              "query"
            ],
            "title": "SearchInput",
            "type": "object"
          }
        }
      }
    },
    "get_evidence_context": {
      "input": {
        "additionalProperties": false,
        "properties": {
          "chunk_id": {
            "format": "uuid",
            "title": "Chunk Id",
            "type": "string"
          },
          "document_version_id": {
            "format": "uuid",
            "title": "Document Version Id",
            "type": "string"
          },
          "neighbors": {
            "default": 0,
            "maximum": 2,
            "minimum": 0,
            "title": "Neighbors",
            "type": "integer"
          }
        },
        "required": [
          "chunk_id",
          "document_version_id"
        ],
        "title": "ContextInput",
        "type": "object"
      },
      "output": {
        "$defs": {
          "ChunkResult": {
            "additionalProperties": false,
            "properties": {
              "chunk_id": {
                "format": "uuid",
                "title": "Chunk Id",
                "type": "string"
              },
              "document_version_id": {
                "format": "uuid",
                "title": "Document Version Id",
                "type": "string"
              },
              "index_id": {
                "format": "uuid",
                "title": "Index Id",
                "type": "string"
              },
              "text": {
                "maxLength": 20000,
                "title": "Text",
                "type": "string"
              },
              "content_hash": {
                "pattern": "^[0-9a-f]{64}$",
                "title": "Content Hash",
                "type": "string"
              },
              "locator": {
                "additionalProperties": true,
                "title": "Locator",
                "type": "object"
              },
              "applicability": {
                "additionalProperties": true,
                "title": "Applicability",
                "type": "object"
              }
            },
            "required": [
              "chunk_id",
              "document_version_id",
              "index_id",
              "text",
              "content_hash",
              "locator",
              "applicability"
            ],
            "title": "ChunkResult",
            "type": "object"
          }
        },
        "additionalProperties": false,
        "properties": {
          "empty": {
            "title": "Empty",
            "type": "boolean"
          },
          "chunks": {
            "items": {
              "$ref": "#/$defs/ChunkResult"
            },
            "maxItems": 5,
            "title": "Chunks",
            "type": "array"
          }
        },
        "required": [
          "empty",
          "chunks"
        ],
        "title": "ContextData",
        "type": "object"
      },
      "langchain": {
        "type": "function",
        "function": {
          "name": "get_evidence_context",
          "description": "Read a permitted chunk and at most two neighbors each side in the same version. Requires current source authorization, returns locators; chunk ID is not evidence ID.",
          "parameters": {
            "additionalProperties": false,
            "properties": {
              "chunk_id": {
                "format": "uuid",
                "title": "Chunk Id",
                "type": "string"
              },
              "document_version_id": {
                "format": "uuid",
                "title": "Document Version Id",
                "type": "string"
              },
              "neighbors": {
                "default": 0,
                "maximum": 2,
                "minimum": 0,
                "title": "Neighbors",
                "type": "integer"
              }
            },
            "required": [
              "chunk_id",
              "document_version_id"
            ],
            "title": "ContextInput",
            "type": "object"
          }
        }
      }
    },
    "get_measurement_spec": {
