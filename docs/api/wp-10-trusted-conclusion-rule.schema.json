{
  "additionalProperties": false,
  "properties": {
    "format_version": {
      "const": 1,
      "default": 1,
      "title": "Format Version",
      "type": "integer"
    },
    "rule_id": {
      "format": "uuid",
      "title": "Rule Id",
      "type": "string"
    },
    "owner_id": {
      "format": "uuid",
      "title": "Owner Id",
      "type": "string"
    },
    "case_id": {
      "format": "uuid",
      "title": "Case Id",
      "type": "string"
    },
    "profile": {
      "enum": [
        "formal",
        "synthetic"
      ],
      "title": "Profile",
      "type": "string"
    },
    "component_key": {
      "maxLength": 100,
      "minLength": 1,
      "title": "Component Key",
      "type": "string"
    },
    "kind": {
      "enum": [
        "connector_detached_hypothesis",
        "housing_intact_comparison_exclusion"
      ],
      "title": "Kind",
      "type": "string"
    },
    "evidence_id": {
      "format": "uuid",
      "title": "Evidence Id",
      "type": "string"
    },
    "document_version_id": {
      "format": "uuid",
      "title": "Document Version Id",
      "type": "string"
    },
    "quote_sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "title": "Quote Sha256",
      "type": "string"
    },
    "authorization_epoch": {
      "minimum": 0,
      "title": "Authorization Epoch",
      "type": "integer"
    },
    "reviewed_by": {
      "format": "uuid",
      "title": "Reviewed By",
      "type": "string"
    },
    "reviewed_at": {
      "format": "date-time",
      "title": "Reviewed At",
      "type": "string"
    },
    "engine": {
      "enum": [
        "off",
        "on"
      ],
      "title": "Engine",
      "type": "string"
    },
    "spec_id": {
      "anyOf": [
        {
          "format": "uuid",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spec Id"
    },
    "spec_definition_sha256": {
      "anyOf": [
        {
          "pattern": "^[0-9a-f]{64}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Spec Definition Sha256"
    }
  },
  "required": [
    "rule_id",
    "owner_id",
    "case_id",
    "profile",
    "component_key",
    "kind",
    "evidence_id",
    "document_version_id",
    "quote_sha256",
    "authorization_epoch",
    "reviewed_by",
    "reviewed_at",
    "engine"
  ],
  "title": "TrustedConclusionRule",
  "type": "object"
}
