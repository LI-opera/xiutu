# Copy to deploy/docker/.env and fill in. Never commit .env.

# Database password: letters and digits only (it goes into a connection URL).
XIUTU_DB_PASSWORD=
# Access token entered on the login page: 32 or more characters.
XIUTU_ACCESS_TOKEN=

# Web page port (default 8080): http://localhost:8080
# XIUTU_WEB_PORT=8080

# Optional local BGE-M3 model folder (the snapshot with model.onnx or onnx/model.onnx).
# Without it the app runs; analyses send whole manuals and uploading new manuals is unavailable.
# XIUTU_BGE_M3_DIR=E:/AI_Cache/huggingface/models--BAAI--bge-m3/snapshots/5617a9f61b028005a4858fdac845db406aefb181

# Optional real AI analysis (paid). Also enable the usage ledger once, see README.
# DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
